function fillAndSubmitCF7Form(submissionData, formSelector = ".wpcf7-form") {
  const $form = jQuery(formSelector);

  if (!$form.length) return;

  // Fill matching fields
  jQuery.each(submissionData, function (key, value) {
    const $field = $form.find(`[name="${key}"]`);
    if ($field.length) {
      if ($field.is("input, textarea")) {
        $field.val(value);
      }
    }
  });

  // Submit the form
  $form.submit();
}

/*
 *
 * Google map init to Choose-car template
 *
 */
function initMap() {
  const directionsService = new google.maps.DirectionsService();
  const directionsRenderer = new google.maps.DirectionsRenderer();

  const map = new google.maps.Map(document.getElementById("map"), {
    zoom: 7,
    center: { lat: 48.21019, lng: 16.33043 }, // Centered on Vienna
  });

  directionsRenderer.setMap(map);

  let destination_to_passed_to_Maps = destination_to;
  let destination_from_passed_to_Maps = destination_from;
  if (destination_to_passed_to_Maps == "Baja") {
    destination_to_passed_to_Maps = "Baja, Hungary";
  }

  if (destination_from_passed_to_Maps == "Baja") {
    destination_from_passed_to_Maps = "Baja, Hungary";
  }

  const request = {
    origin: destination_from_passed_to_Maps,
    destination: destination_to_passed_to_Maps,
    /*waypoints: [
      {
        location: "Philadelphia, PA",
        stopover: true,
      },
    ],*/
    travelMode: google.maps.TravelMode.DRIVING,
  };

  directionsService.route(request, (result, status) => {
    if (status === "OK") {
      directionsRenderer.setDirections(result);

      const route = result.routes[0].legs[0]; // first leg of the first route
      const distance = route.distance.text; // e.g. "250 km"
      const duration = route.duration.text; // e.g. "2 hours 45 mins"

      // Example: show inside an element
      document.getElementById("route-info").innerHTML =
        "Distance: " + distance + " | Duration: " + duration;
    }
  });
}
