// DOM Ready
jQuery(document).ready(function ($) {
  // Responsive Projects, iPhone/iPad URL bar hides itself on pageload
  if (navigator.userAgent.indexOf("iPhone") != -1) {
    addEventListener(
      "load",
      function () {
        setTimeout(hideURLbar, 0);
      },
      false
    );
  }

  function hideURLbar() {
    window.scrollTo(0, 0);
  }

  /*
   *
   * Anqor links
   *
   * */
  $('a[href*="#"]').on("click", function (e) {
    var hash = this.hash;

    if (hash) {
      var target = $(hash);
      if (target.length) {
        e.preventDefault(); // Only block if we have a match
        $("html, body").animate({ scrollTop: target.offset().top - 80 }, 600);
      }
      // If the target is not found → do nothing → default behavior happens
    }
  });

  /*
   *
   * Anqor links on page load
   *
   * */
  if (window.location.hash) {
    var target = $(window.location.hash);
    if (target.length) {
      $("html, body").animate({ scrollTop: target.offset().top - 80 }, 600);
    }
  }

  /*
   *
   * Read more on CAR DETAILS
   *
   * */
  document.querySelectorAll(".read-more").forEach(function (link) {
    link.addEventListener("click", function (e) {
      e.preventDefault();
      this.previousElementSibling.style.display = "inline";
      this.style.display = "none";
    });
  });

  /*
   *
   * Front page from-to select2 and select change
   *
   */
  let isChanging = false;

  // Initialize Select2
  $(".main-search-container select").each(function () {
    let noResultsMsg =
      $(this).attr("id") === "from"
        ? "Please choose one of the options listed here! If you don't choose a starting point or it's not listed, you won't find a travel option! In this case, please write us a message using the contact menu and we will get back to you as soon as possible! <a href='/contact'>Contact</a>"
        : "Please choose one of the options listed here! If you do not select an arrival point or it is not listed, you will not find a travel option! In this case, please send us a message using the contact menu item and we will contact you as soon as possible! <a href='/contact'>Contact</a>";

    $(this)
      .select2({
        dropdownParent: $("body"),
        width: "resolve",
        language: {
          noResults: function () {
            return noResultsMsg;
          },
        },
        escapeMarkup: function (markup) {
          return markup;
        },
      })
      .on("select2:open", function () {
        document.activeElement.blur();
      });
  });

  // --- Prevent selecting the same option in from and to select ---
  $("#from, #to").on("change", function () {
    const fromVal = $("#from").val();
    const toVal = $("#to").val();

    // Enable all options first
    $("#from option, #to option").prop("disabled", false);

    // Disable the selected value of the other select
    if (fromVal) {
      $("#to option[value='" + fromVal + "']").prop("disabled", true);
    }
    if (toVal) {
      $("#from option[value='" + toVal + "']").prop("disabled", true);
    }

    // Refresh Select2 to reflect disabled state
    $("#from, #to").trigger("change.select2");
  });

  // Helper: Get URL parameter
  function getUrlParam(param) {
    const url = new URL(window.location.href);
    return url.searchParams.get(param)?.replace(/\/$/, "").toLowerCase(); // remove trailing slash
  }

  // Set the other field to "Budapest"
  function setOtherToBudapest(changedId) {
    if (isChanging) return;

    const otherId = changedId === "from" ? "to" : "from";
    const $other = $("#" + otherId);
    const exists = $other.find('option[value="Budapest"]').length > 0;

    if (exists) {
      isChanging = true;
      $other.val("Budapest").trigger("change");
      isChanging = false;
    }
  }

  // Handle manual selection
  $("#from").on("change", function () {
    if ($(this).val() !== "Budapest") {
      setOtherToBudapest("from");
    }
  });

  $("#to").on("change", function () {
    if ($(this).val() !== "Budapest") {
      setOtherToBudapest("to");
    }
  });

  // Auto-set based on URL params
  const urlFrom = getUrlParam("from");
  const urlTo = getUrlParam("to");

  if (urlFrom) {
    const $fromOption = $("#from option").filter(function () {
      return $(this).val().replace(/\s+/g, "-").toLowerCase() === urlFrom;
    });

    if ($fromOption.length) {
      $("#from").val($fromOption.val()).trigger("change");
    }
  }

  if (urlTo) {
    const $toOption = $("#to option").filter(function () {
      return $(this).val().replace(/\s+/g, "-").toLowerCase() === urlTo;
    });

    if ($toOption.length) {
      $("#to").val($toOption.val()).trigger("change");
    }
  }

  // If only one of them is set, force the other to Budapest
  if (urlFrom && !urlTo) {
    setOtherToBudapest("from");
  }

  if (urlTo && !urlFrom) {
    setOtherToBudapest("to");
  }

  /*
   *
   * Trip price növelés - csökkentés
   *
   */
  $(".trip-item-inner").each(function () {
    const $trip = $(this);
    const basePrice = parseInt($trip.data("price-hour"));
    let currentTime = 60;

    const $priceDisplay = $trip.find(".trip-price");
    const $timeDisplay = $trip.find(".trip-price-time");

    function updateDisplay(newTime) {
      currentTime = newTime;
      let newPrice = Math.round((basePrice / 60) * currentTime);

      $timeDisplay.text(currentTime);
      $priceDisplay.text(newPrice);

      // ✅ Set the actual HTML attributes:
      $trip.attr("data-price-actual", newPrice);
      $trip.attr("data-time-actual", newTime);
    }

    $trip.find(".trip-price-minus").click(function () {
      if (currentTime > 30) {
        updateDisplay(currentTime - 10);
      }
    });

    $trip.find(".trip-price-plus").click(function () {
      if (currentTime < 240) {
        updateDisplay(currentTime + 10);
      }
    });
  });

