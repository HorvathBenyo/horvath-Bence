    // Find closest h1 above the button
    var h1 = $btn.closest("p").prevAll("h1").first().text().trim();
    if (!h1) {
      h1 = $section.find("h1").first().text().trim() || "Unknown Destination";
    }

    // Find closest h3 above the button
    var h3 = $btn.closest("p").prevAll("h3").first().text().trim();
    if (!h3) h3 = "";

    // Strip HTML tags (like <strong> or <em>)
    h1 = $("<div>").html(h1).text();
    h3 = $("<div>").html(h3).text();

    // Combine for destination field
    var destinationText = h1;
    if (h3) destinationText += " – " + h3;

    // Fill modal input
    $("#destination").val(destinationText);

    // Show modal
    $("#tripModal").modal("show");
  });


