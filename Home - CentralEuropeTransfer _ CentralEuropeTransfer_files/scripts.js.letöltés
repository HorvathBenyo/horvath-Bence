  $(".wpcf7-submit").each(function () {
    $(this).addClass("green-btn");
  });

  /*
   *
   * Extra trips stored and visualized in the footer
   *
   */
  function setCookie(name, value, days) {
    let expires = "";
    if (days) {
      const date = new Date();
      date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
      expires = "; expires=" + date.toUTCString();
    }
    document.cookie =
      name + "=" + encodeURIComponent(value) + expires + "; path=/";
  }

  function deleteCookie(name) {
    setCookie(name, "", -1);
  }

  function getCookie(name) {
    let match = document.cookie.match(new RegExp("(^| )" + name + "=([^;]+)"));
    return match ? decodeURIComponent(match[2]) : null;
  }

  let trips = getCookie("selectedTrips")
    ? JSON.parse(getCookie("selectedTrips"))
    : [];

  function saveTrips() {
    setCookie("selectedTrips", JSON.stringify(trips), 7); // store for 7 days
  }

  function renderTripBar() {
    let $tripItems = $("#trip-bar-items");
    let $addedStops = $("#added-stops");
    let $finalPrice = $("#final-price");
    let $finalTextAfterCar = $("#final-text-after-car");
    let $hiddenTripsInput = $("input[name='trips']");
    let $hiddenFinalPriceInput = $("input[name='finalprice']");

    // Don't draw it on thank you page
    if ($("body.page-template-page-thank-you").length > 0) {
      deleteCookie("selectedTrips");
      return;
    }

    $tripItems.empty();
    $addedStops.empty();

    let availableTrips = null;

    // Only check available trips if #added-stops exists
    if ($addedStops.length) {
      availableTrips = $addedStops.data("available-trips");
      if (!Array.isArray(availableTrips)) {
        console.warn("No valid available trips found.");
        availableTrips = null;
      }
    }

    let totalTripPrice = 0;
    let selectedTrips = [];

    if (Array.isArray(trips)) {
      trips.forEach((trip, index) => {
        if (availableTrips) {
          let matchedTrip = availableTrips.find(
            (avail) => avail.title === trip.title
          );
          if (!matchedTrip) return;
        }

        let tripHtml = `
          <span class="footer-tripitem">
            ${trip.title} - ${trip.price}€ / ${trip.time} min
            <button class="trip-remove" data-index="${index}">
              <span class="material-icons">close</span>
            </button>
          </span>
        `;

        $tripItems.append(tripHtml);
        $addedStops.append(tripHtml);

        totalTripPrice += parseFloat(trip.price);

        selectedTrips.push({
          title: trip.title,
          price: trip.price,
          time: trip.time,
        });
      });
    }

    // Always calculate final price (even if no trips)
    let selectedCar = $('input[name="chosen_car"]:checked');
    let carPrice = selectedCar.length
      ? parseFloat(selectedCar.data("price"))
      : 0;
    let finalPrice = totalTripPrice + carPrice;
    let finalTextAfterPrice = selectedCar.data("car-aftertext");

    // Update visible final price
    $finalPrice.text(`${finalPrice}`);
    $finalTextAfterCar.text(`${finalTextAfterPrice}`);

    // Update hidden fields
    if ($hiddenTripsInput.length) {
      $hiddenTripsInput.val(JSON.stringify(selectedTrips));
    }

    if ($hiddenFinalPriceInput.length) {
      $hiddenFinalPriceInput.val(finalPrice);
    }

    // Show or hide the trip bar based on whether there are trip items
    if ($tripItems.children().length > 0) {
      $("#trip-bar").show();
    } else {
      $("#trip-bar").hide();
    }
  }

  // Update cookie when item removed
  $(document).on("click", ".trip-remove", function () {
    let index = $(this).data("index");
    trips.splice(index, 1);
    saveTrips();
    renderTripBar();
  });

  // Update cookie when item removed
  $(document).on("click", ".trip-remove", function () {
    let index = $(this).data("index");
    trips.splice(index, 1);
    saveTrips();
    renderTripBar();
  });

  // Add trip
  $(".trip-btn1").on("click", function () {
    let tripEl = $(this).closest(".trip-item-inner");
    let title = tripEl.data("title");
    let price = tripEl.attr("data-price-actual");
    let time = tripEl.attr("data-time-actual");

    if (!trips.some((t) => t.title === title)) {
      trips.push({ title, price, time });
      saveTrips();
      renderTripBar();
    } else {
      alert(`"${title}" is already added.`);
    }
  });

  renderTripBar();

  /*
