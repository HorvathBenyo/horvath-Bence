function slider(widget, widgetState) {
  const { widget_data } = widgetState;
  const { settings } = widget_data;
  const slider = widget.querySelector(".sk-slider");
  const slides = widget.querySelectorAll(".sk-slide");
  const btnLeft = widget.querySelector(".sk-slider__btn--left");
  const btnRight = widget.querySelector(".sk-slider__btn--right");
  const dotContainer = widget.querySelector(".sk-dots");
  let curSlide = 0;
  const maxSlide = slides.length;

  if (!slider) return;

  function createDots() {
    slides.forEach((_, i) => {
      dotContainer.insertAdjacentHTML(
        "beforeend",
        `
            <button class="sk-dots__dot" data-slide="${i}"></button>`
      );
    });
  }

  function activateDot(slide) {
    widget.querySelectorAll(".sk-dots__dot").forEach(dot => dot.classList.remove("sk-dots__dot--active"));
    const dotToActivate = widget.querySelector(`.sk-dots__dot[data-slide="${slide}"]`);
    if (dotToActivate) {
      dotToActivate.classList.add("sk-dots__dot--active");
    }
  }

  function goToSlide(slide) {
    slides.forEach(
      (s, i) => (s.style.transform = `translate3d(${100 * (i - slide)}%, 0, 0)`)
    );
  }

  function nextSlide() {
    if (curSlide === maxSlide - 1) {
      curSlide = 0;
    } else {
      curSlide++;
    }

    goToSlide(curSlide);
    activateDot(curSlide);
  }

  function prevSlide() {
    if (curSlide === 0) {
      curSlide = maxSlide - 1;
    } else {
      curSlide--;
    }

    goToSlide(curSlide);
    activateDot(curSlide);
  }

  let autoplayInterval;

  function startAutoplay() {
    if (settings.autoplay == 1) {
      autoplayInterval = setInterval(
        nextSlide,
        Number(settings.delay) * 1000 || 8000
      );
    }
  }

  function stopAutoplay() {
    if (autoplayInterval) {
      clearInterval(autoplayInterval);
    }
  }

  function init() {
    goToSlide(0);
    createDots();
    activateDot(0);
    startAutoplay();
  }

  init();

  if (btnRight) btnRight.addEventListener("click", nextSlide);
  if (btnLeft) btnLeft.addEventListener("click", prevSlide);

  document.addEventListener("keydown", function (e) {
    // While the review popup is open its own arrow keys win.
    if (document.querySelector(".sk-post-modal-overlay--active")) return;
    if (e.key === "ArrowLeft") prevSlide();
    e.key === "ArrowRight" && nextSlide();
  });

  dotContainer.addEventListener("click", function (e) {
    if (e.target.classList.contains("sk-dots__dot")) {
      const { slide } = e.target.dataset;
      goToSlide(Number(slide));
      activateDot(slide);
      curSlide = Number(slide);
    }
  });
}

function generateSlidesHtml(slides, columns) {
  return slides.map((slideItems) => {
    const slideDiv = document.createElement("div");
    slideDiv.className = "sk-slide";

    slideItems.forEach((item) => {
      const itemDiv = document.createElement("div");
      itemDiv.className = "sk-slide-item";
      itemDiv.innerHTML = item;
      slideDiv.appendChild(itemDiv);
    });
    if (slideItems.length < parseInt(columns)) {
        const missingItems = parseInt(columns) - slideItems.length;
        for (let i = 0; i < missingItems; i++) {
            const emptyDiv = document.createElement("div");
            emptyDiv.className = "sk-slide-item";
            slideDiv.appendChild(emptyDiv)
        }
    }

    return slideDiv;
  });
}

function groupItems(items, itemsPerSlide) {
  let slides = [];
  for (let i = 0; i < items.length; i += itemsPerSlide) {
    slides.push(items.slice(i, i + itemsPerSlide));
  }
  return slides;
}

