function formatDate(dateInput, format, language = "English") {
    const date = new Date(dateInput);
    const {
        monthNames,
        dateFormats,
        ordinalSuffix
    } = translations[language];

    const day = date.getDate();
    const month = monthNames[date.getMonth()];
    const fullMonth = monthNames[date.getMonth()];
    const year = date.getFullYear();

    const getOrdinalSuffix = (n) => {
        const s = ordinalSuffix;
        const v = n % 100;
        return s[(v - 20) % 10] || s[v] || s[0];
    };

    const formatString = dateFormats[format] || date.toLocaleDateString(language);

    if (format === "ago_value" || format === "time_ago") {
        return timeAgo(date, language);
    }

    return formatString
        .replace("{month}", month)
        .replace("{fullMonth}", fullMonth)
        .replace("{day}", String(day).padStart(2, "0"))
        .replace("{year}", year)
        .replace("{ordinal}", getOrdinalSuffix(day));
}

function timeAgo(date, lang = "English") {
    const now = new Date();
    const seconds = Math.floor((now - date) / 1000);
    const minutes = Math.floor(seconds / 60);
    const hours = Math.floor(minutes / 60);
    const days = Math.floor(hours / 24);
    const weeks = Math.floor(days / 7);

    const translation = translations[lang] || translations["English"];

    const formatAgo = (value, unit) => {
        return translation.dateFormats.ago_value
            .replace("{value}", value)
            .replace("{unit}", translation.timeUnits[unit]);
    };

    if (seconds < 60) return formatAgo(seconds, "second");
    if (minutes < 60) return formatAgo(minutes, "minute");
    if (hours < 24) return formatAgo(hours, "hour");
    if (days < 7) return formatAgo(days, "day");
    return formatAgo(weeks, "week");
}

