function truncateHtml(html, limit) {
    let content = document.createElement("div");
    content.innerHTML = html;

    let truncated = "";
    let count = 0;
    let tags = [];

    function traverse(node) {
        if (count >= limit) return;

        if (node.nodeType === Node.TEXT_NODE) {
            let text = node.textContent;
            if (count + text.length > limit) {
                truncated += text.substring(0, limit - count);
                count = limit;
            } else {
                truncated += text;
                count += text.length;
            }
        } else if (node.nodeType === Node.ELEMENT_NODE) {
            const tagName = node.tagName.toLowerCase();
            if (count >= limit) {
                return;
            }

            truncated += `<${tagName}`;

            // Handle attributes
            Array.from(node.attributes).forEach((attr) => {
                truncated += ` ${attr.name}="${attr.value.replace(/"/g, "&quot;")}"`;
            });

            truncated += ">";
            tags.push(tagName);

            // Handle child nodes
            Array.from(node.childNodes).forEach((child) => traverse(child));

            if (count < limit) {
                truncated += `</${tagName}>`;
                tags.pop();
            }
        }
    }

    traverse(content);

    // Close any remaining open tags
    while (tags.length > 0) {
        truncated += `</${tags.pop()}>`;
    }
    // Add ellipsis if truncated
    if (count >= limit) {
        truncated += "...";
    }
    truncated = truncated.replaceAll("<span><br></br></span>", "<span><br></span>");
    return truncated;
}

