    if (window.sk_embed_data && window.sk_embed_data[embedId]) {
        widgetState.widget_data = normalizeTripadvisorWidgetData(
            window.sk_embed_data[embedId],
            embedId
        );

        if (!widgetState.widget_data) {
            await fetchSettings(widgetState, embedId);
        }

        return;
    }

    try {
        const json_url = `${app_file_server_url}${embedId}.json?nocache=${new Date().getTime()}`;

        const res = await fetch(json_url);

        if (!res.ok) {
            throw new Error(`Failed to fetch data: ${res.statusText}`);
        }

        const raw = await res.json();
        widgetState.widget_data = normalizeTripadvisorWidgetData(raw, embedId);
        if (!widgetState.widget_data) {
            await fetchSettings(widgetState, embedId);
        }
    } catch (err) {
        await fetchSettings(widgetState, embedId);
        console.error("Error fetching data:", err);
    }
}

async function fetchSettings(widgetState, embedId) {
    const { app_file_server_url } = widgetState;

    try {
        const res = await fetch(
            `${app_file_server_url.replace("feed", "")}settings/${embedId}/settings.json?nocache=${new Date().getTime()}`
        );

        if (!res.ok) {
            throw new Error(`Failed to fetch data: ${res.statusText}`);
        }

        widgetState.widget_data = {};
        widgetState.widget_data.settings = await res.json();
        widgetState.widget_data = normalizeTripadvisorWidgetData(widgetState.widget_data, embedId);
    } catch (err) {
        console.error("Error fetching data:", err);
    }
}

async function initializeWidget(widget, embedId) {
    const widgetState = {
        widget_data: null,
        itemsPerPage: 6,
        currentPage: 1,
        currentIndex: 0,
        sources: null,
        currentTab: "All",
        column_count_small: 1,
        column_count_medium: 2,
        column_count_large: 3,
        embedId,
        recorded_file_link: "",
        realignmentTimeoutId: null,
    };

    getEnvironmentUrls(widgetState, "tripadvisor-reviews");

    widget.innerHTML = ``;

    try {
        await fetchData(widgetState, embedId);
    } catch (err) {
        console.error(err);
    }

    renderClick(widget, widgetState);
    renderScroll(widget, widgetState);
    renderViews(widget, widgetState);
    trackImageLoadErrors(widget, widgetState);

    const { hideLoader } = skLoader(widget);

    const STYLESHEET_PATH = `${widgetState.app_url}tripadvisor-reviews/new/styles.css?v=${new Date().getTime()}`;
    widgetState.spriteURL = `${widgetState.app_url}tripadvisor-reviews/new/assets/sprite.svg`;
    loadStylesheet(
        `https://fonts.googleapis.com/css?family=${encodeURIComponent(
            (widgetState.widget_data && widgetState.widget_data.settings && widgetState.widget_data.settings.font_family) || "Arial"
        )}`
    );
    loadStylesheet(STYLESHEET_PATH, function () {
        if (widgetState.widget_data) {
            if (!widgetState.widget_data.reviews) {
                widgetState.widget_data.reviews = [];
            }
            if (widgetState.widget_data.settings.layout !== "3") {
                updateSources(widgetState);
            }
            hideLoader();

            renderLayout(widget, widgetState);
            attachEventListeners(widget, widgetState);

            const pageReviewsEl = widget.querySelector(".sk-page-reviews");
            if (pageReviewsEl) pageReviewsEl.style.visibility = "visible";

            const postsContainerEl = widget.querySelector(".sk-posts-container");
            if (postsContainerEl) postsContainerEl.style.visibility = "visible";

            const profileEl = widget.querySelector(".sk-profile");
            if (profileEl) profileEl.style.visibility = "visible";

            initUpdatePreview(widget, widgetState, renderLayout, applySettings, {
                body: ".sk-posts-container",
                header: ".sk-profile",
                footer: ".sk-load-more-btn-container",
            });
        } else {
            console.error("Failed to initialize widget due to missing data.");
        }
    });
}

async function renderFunction() {
    const widgets = document.querySelectorAll(".sk-ww-tripadvisor-reviews");

    function handleImageError(event) {
        if (event.target.tagName === "IMG") {
            const imgElement = event.target;
            const classNames = [
                ".image-container",
                ".post__thumbnail-container",
                ".post__user-image-container",
                ".article__image-container",
                ".post-modal__user-image",
                ".image-container-slide",
            ];

            for (const className of classNames) {
                const parentContainer = imgElement.closest(className);
                if (parentContainer) {
                    parentContainer.classList.add("image-error");
                    break;
                }
            }
        }
    }

    widgets.forEach((widget) => {
        const uiType = widget.getAttribute("data-ui");

        if (!uiType || widget.getAttribute("data-ui") !== "old") {
            const embedId = widget.getAttribute("data-embed-id");
            widget.addEventListener("error", handleImageError, true);
            initializeWidget(widget, embedId);
        }
    });
}

if (document.readyState === "complete" || document.readyState === "interactive") {
    renderFunction();
} else {
    document.addEventListener("DOMContentLoaded", async () => {
        renderFunction();
    });
}

function getBreakpoint() {
    if (window.innerWidth < 520) return "mobile";
    if (window.innerWidth < 767) return "tablet";
    return "desktop";
}

let currentBreakpoint = getBreakpoint();

function handleResize() {
    const newBreakpoint = getBreakpoint();

    if (newBreakpoint !== currentBreakpoint) {
        currentBreakpoint = newBreakpoint;

        const widgets = document.querySelectorAll(".sk-ww-tripadvisor-reviews");
        widgets.forEach((widget) => {
            const uiType = widget.getAttribute("data-ui");

            if (!uiType || widget.getAttribute("data-ui") !== "old") {
                const embedId = widget.getAttribute("data-embed-id");
                initializeWidget(widget, embedId);
            }
        });
    }
}

window.addEventListener("resize", debounce(handleResize, 300));

function debounce(func, wait) {
    let timeout;
    return function (...args) {
        const context = this;
        clearTimeout(timeout);
        timeout = setTimeout(() => func.apply(context, args), wait);
    };
}
}(window, document));