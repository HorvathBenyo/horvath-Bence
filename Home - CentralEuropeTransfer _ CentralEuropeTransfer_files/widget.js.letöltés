function trackImageLoadErrors(widget, widgetState, title = 'Image load failed') {
    if (!widget) return;

    const widget_data = (widgetState && widgetState.widget_data) || {};
    const solution_info = widget_data.solution_info || {};
    const settings = widget_data.settings || {};
    const user_info = widget_data.user_info || {};

    const embed_id =
        solution_info.embed_id ||
        settings.embed_id ||
        user_info.embed_id ||
        widget.getAttribute('data-embed-id');

    // Track paid, trial, to-cancel, and free customers.
    if (solution_info.status && ![1, 6, 7, 13].includes(parseInt(solution_info.status))) {
        return false;
    }

    if (widget.__skImageErrorTracked) return;
    widget.__skImageErrorTracked = true;

    const current_url = getCurrentUrl();

    const sk_api_url = current_url.indexOf('local') !== -1
        ? "http:localhost:8000/"
        : "https://api.sociablekit.com/";

    const failedSrcs = new Set();
    const failedImages = new Set();
    let alertTimeout;

    // Caps the retry cost: probes only ever run for images that already failed.
    const PROBE_LIMIT = 5;
    const PROBE_TIMEOUT_MS = 8000;

    const getTrackableImageSrc = (img) => {
        const src = (img.currentSrc || img.src || '').trim();
        if (!src) return '';

        try {
            const pathname = new URL(src, document.baseURI).pathname;
            return /\.(jpe?g|png|webp)$/i.test(pathname) ? src : '';
        } catch (e) {
            const pathname = src.split(/[?#]/)[0];
            return /\.(jpe?g|png|webp)$/i.test(pathname) ? src : '';
        }
    };

    // Hosts that send Access-Control-Allow-Origin, so a ranged read is possible.
    const allowsRangeProbe = (src) => {
        try {
            const host = new URL(src, document.baseURI).hostname;
            return host === window.location.hostname || /(^|\.)sociablekit\.com$/i.test(host);
        } catch (e) {
            return false;
        }
    };

    // A failed load is not proof the URL is bad: image files are re-synced on the
    // server and single requests can drop mid-flight. Re-request once and keep only
    // the URLs that fail again. Inconclusive probes are treated as working.
    const probeIsStillBroken = (src) => new Promise((resolve) => {
        let settled = false;
        let timer;

        const finish = (broken) => {
            if (settled) return;
            settled = true;
            clearTimeout(timer);
            resolve(broken);
        };

        timer = setTimeout(() => finish(false), PROBE_TIMEOUT_MS);

        const imageProbe = () => {
            const probe = new Image();
            probe.onload = () => finish(false);
            probe.onerror = () => finish(true);
            probe.src = src;
        };

        if (!allowsRangeProbe(src)) {
            imageProbe();
            return;
        }

        try {
            // 'bytes=0-0' is CORS-safelisted, so this costs one byte and no preflight.
            fetch(src, { method: 'GET', headers: { Range: 'bytes=0-0' }, cache: 'no-store' })
                .then((response) => finish(response.status >= 400))
                .catch(imageProbe);
        } catch (e) {
            imageProbe();
        }
    });

    const sendAlert = async () => {
        // re-check: only count images that are STILL broken at send time.
        // (transient errors that recovered via an onerror fallback / srcset
        //  no longer count, so we don't alert when the widget looks fine.)
        const candidates = [];
        failedImages.forEach((img) => {
            const stillBroken = img.complete && img.naturalWidth === 0;
            if (!stillBroken || !img.isConnected || !widget.contains(img)) return;

            const src = getTrackableImageSrc(img);
            if (src && !candidates.includes(src)) {
                candidates.push(src);
            }
        });
        failedImages.clear();

        if (candidates.length === 0) return;

        // An offline visitor fails every request; that says nothing about the URL.
        if (navigator.onLine === false) return;

        const probed = candidates.slice(0, PROBE_LIMIT);
        const results = await Promise.all(probed.map(probeIsStillBroken));
        const confirmed = probed.filter((src, index) => results[index]);

        if (confirmed.length === 0) return;

        // Unprobed candidates only count when every probe came back broken.
        const failedCount = confirmed.length === probed.length ? candidates.length : confirmed.length;
        const brokenImages = confirmed.slice(0, 3);

        const message = "Broken Images:\n" + brokenImages.join("\n");

        const store_image_error_url = sk_api_url + "api/devs/loading-image-error?" + new URLSearchParams({
            message: message,
            image_count: failedCount,
            broken_images: JSON.stringify(brokenImages),
            page_location: current_url,
            type_name: title || 'Image load failed',
            embed_id: embed_id || '',
        }).toString();

        try {
            fetch(store_image_error_url, { method: 'GET', keepalive: true }).catch(() => {});
        } catch (e) {
        }
    };

    const handleImageError = (event) => {
        const target = event.target;
        if (!target || target.tagName !== 'IMG' || !widget.contains(target)) return;

        const src = getTrackableImageSrc(target);
        if (!src) return;
        if (src && failedSrcs.has(src)) return;
        if (src) failedSrcs.add(src);

        failedImages.add(target);

        clearTimeout(alertTimeout);
        alertTimeout = setTimeout(() => { sendAlert().catch(() => {}); }, 3000);
    };

    widget.addEventListener('error', handleImageError, true);
}

async function sendGchatAlert(payload, widgetState) {
    const { sk_app_url, widget_data } = widgetState;
    const { embed_id } = widget_data.solution_info;

    let baseUrl = "https://alert.sociablekit.com/google-alert.php";
    const localIdentifiers = ["localhost", "127.0.0.1", "localtesting"];

    if (localIdentifiers.some(id => window.location.hostname.includes(id))) {
        baseUrl = "https://localtesting.com/Codalify_Alerts/google-alert.php";
