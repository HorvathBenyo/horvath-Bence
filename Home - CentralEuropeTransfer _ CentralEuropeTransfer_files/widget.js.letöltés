function renderLayout(widget, widgetState) {
    generateHTML(widget, widgetState);
    applySettings(widget, widgetState);
    renderPosts(widget, widgetState);
} 

function generateHTML(widget, widgetState) {
    const {
        widget_data,
        spriteURL,
        app_url
    } = widgetState;
    const {
        reviews,
        settings,
        google_data_structure_json
    } = widget_data;
    const embed_id = settings.embed_id != null ? settings.embed_id : widgetState.embedId;
    const turn_off_google_schema = settings.turn_off_google_schema;

    // Temporarily hide container as to not render before applying css settings
    // Prevents briefly showing broken styles on load
    const html = `
        <div class="sk-page-reviews js-sk-page-reviews">
            ${generateHTMLProfile(widget, widgetState)}
            <div class="sk-posts-container js-posts-container">
            </div>
            <div class="sk-load-more-btn-container js-load-more-btn-container"></div>
            ${generateHTMLModal(widget, widgetState)}
            ${generateHTMLPopup(widget, widgetState)}
            ${skGetBranding(widget, widgetState)}
        </div>
    `;

    // apply google data structure
    if (google_data_structure_json
        && embed_id != 168298
        && turn_off_google_schema != 1
    ) {
        var json_string = JSON.stringify(google_data_structure_json);

        function sanitizeJSON(json) {
            return json.replace(/[\\\/\s]/g, '');
        }

        var sanitized_json_string = sanitizeJSON(json_string);

        var existing_script = Array.from(document.querySelectorAll('script[type="application/ld+json"]')).filter(function(script) {
            return sanitizeJSON(script.textContent.trim()) === sanitized_json_string;
        });

        if (!existing_script.length) {
            var script = document.createElement('script');
            script.type = 'application/ld+json';
            script.textContent = json_string;
            document.head.appendChild(script);
        }
    }

    widget.insertAdjacentHTML('beforeend', html);

    if (reviews.length === 0) {
        setTimeout(function () {
            widget.querySelector('.js-sk-page-reviews').insertAdjacentHTML('beforeend', renderNoPostsMessage(widgetState))
        }, 4500)
    }
}

function parseTripadvisorBioOverallRating(bio) {
    if (!bio) return 0;
    var raw =
        bio.overall_rating != null && bio.overall_rating !== ""
            ? bio.overall_rating
            : bio.average_rating != null && bio.average_rating !== ""
            ? bio.average_rating
            : bio.rating != null && bio.rating !== ""
            ? bio.rating
            : 0;
    var n = parseFloat(String(raw).replace(/,/g, ".").replace(/\s/g, ""));
    return isNaN(n) ? 0 : n;
}

function tripadvisorShowOverallRateOn(settings) {
    if (!settings) return false;
    var v = settings.show_overall_rate;
    return v == 1 || v === true || v === "1";
}

function buildTripadvisorFiveStarSvgRow(averageRating) {
    var averageRatingNum = parseFloat(String(averageRating).replace(/,/g, "."));
    if (isNaN(averageRatingNum) || averageRatingNum <= 0) {
        return "";
    }
    const fullStar = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/></svg>`;
    const halfStar = `<svg width="323" height="314" viewBox="0 0 323 314" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M160.22 1C160.63 1 161.038 1.01468 161.444 1.04004V268.766L160.281 268.145L82.4036 309.753C75.8481 313.215 67.8962 312.668 61.887 308.355C55.8778 304.043 52.8429 296.632 54.0569 289.343L68.9886 200.842L5.74052 138.217C0.520387 133.054 -1.30125 125.339 0.944621 118.354C3.19053 111.368 9.26136 106.266 16.5452 105.173L103.709 92.2959L142.739 11.9336C146.016 5.25195 152.754 1 160.22 1Z" fill="black"/>
        <path class="sk-star-empty" d="M162.666 1C162.256 1.00001 161.849 1.01472 161.444 1.04004V268.765L162.606 268.145L240.483 309.753C247.038 313.215 254.99 312.668 260.999 308.355C267.008 304.043 270.043 296.632 268.829 289.343L253.898 200.842L317.146 138.217C322.366 133.054 324.187 125.339 321.942 118.354C319.696 111.368 313.626 106.266 306.342 105.173L219.178 92.2959L180.148 11.9336C176.87 5.25202 170.132 1 162.666 1Z" fill="#C2C2C2"/>
    </svg>`;
    const emptyStar = `<svg class="sk-star-empty" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/></svg>`;

    const starsCount = Math.floor(averageRatingNum);
    const hasHalfStar = averageRatingNum % 1 >= 0.5;
    const totalStars = 5;
    const fullStars = starsCount;
    const halfStars = hasHalfStar ? 1 : 0;
    const emptyStars = totalStars - fullStars - halfStars;

    let starsSVG = "";
    starsSVG += fullStar.repeat(fullStars);
    if (halfStars) starsSVG += halfStar;
    starsSVG += emptyStar.repeat(emptyStars);
    return starsSVG;
}

function generateHTMLBadge(widgetState) {
    const { widget_data } = widgetState;
    const { settings, bio } = widget_data;

    const tripadvisorLink = bio?.link || "#";
    const averageRating = parseTripadvisorBioOverallRating(bio);
    const reviewCount = Number(bio?.review_count || bio?.rating_count || 0);

    const { reviews_text, show_reviews_count } = settings;

    const starsSVG = buildTripadvisorFiveStarSvgRow(averageRating);

    const formattedRating = averageRating > 0 ? averageRating.toFixed(1) : "";
    const reviewCountText =
        show_reviews_count == 1 && reviewCount > 0
            ? `${formatNumberDecimals(reviewCount)} ${reviews_text || "reviews"}`
            : "";
    const ratingBlock =
        tripadvisorShowOverallRateOn(settings) && averageRating > 0
            ? `
                    <div class="sk-badge__rating">
                        <p class="sk-badge__value">${formattedRating}</p>
                        <div class="sk-badge__stars">${starsSVG}</div>
                    </div>
                `
            : "";
    const countBlock =
        show_reviews_count == 1 && reviewCountText
            ? `
                    <a class="sk-badge__count" href="${tripadvisorLink}" target="_blank">
                        ${formattedRating} out of ${reviewCountText}
                    </a>
                `
            : "";

    const writeReviewBtn = `<button class="sk-write-a-review__button" onclick="window.open('${tripadvisorLink}', '_blank')">
        Write a review
    </button>`;

    return `
        <div class="sk-post">
            <div class="sk-badge">
                <div class="sk-badge__logo">
                    ${getBrandIcon('', 'width: 91px; height: 14px; color: currentColor;', 2)}
                </div>

                ${bio?.name ? `<p class="sk-badge__name">${bio.name}</p>` : ""}
                ${ratingBlock}
                ${countBlock}
                ${writeReviewBtn}
            </div>
        </div>
    `;
}

function generateHTMLProfile(widget, widgetState) {
    const { widget_data } = widgetState;
    const { bio, settings } = widget_data;
    const avg = parseTripadvisorBioOverallRating(bio);
    const rcRaw = bio?.review_count ?? bio?.rating_count ?? 0;
    const rc = parseInt(String(rcRaw).replace(/,/g, ""), 10);
    const rcSafe = isNaN(rc) ? 0 : rc;
    const profileStarsSvg = buildTripadvisorFiveStarSvgRow(avg);
    const profileRatingBlock =
        tripadvisorShowOverallRateOn(settings) && avg > 0 && profileStarsSvg
            ? `
                    <div class="sk-profile__rating sk-badge__rating">
                        <p class="sk-badge__value">${avg.toFixed(1)}</p>
                        <div class="sk-badge__stars">${profileStarsSvg}</div>
                    </div>
                `
            : "";
    const {
        show_cover_photo,
        show_name,
        show_reviews_count,
        view_on_tripadvisor_text,
        show_description,
        show_view_on_tripadvisor_button,
        reviews_text,
    } = settings;
    const viewTripadvisorLabel = view_on_tripadvisor_text || "View on Tripadvisor";

    return `
        <div class="sk-profile">
            <div class="sk-profile__info">
                ${show_cover_photo == 1 && bio?.image ? `
                    <div class="sk-profile__picture" style="background-color: var(--image-background);">
                        <img src="${bio.image}" alt="${bio?.name || "Tripadvisor"}"/>
                    </div>
                ` : ""}

                <div class="sk-profile__details">
                    ${show_name == 1 ? `
                        <p class="sk-profile__name">
                            ${bio?.link ? `<a href="${bio.link}" target="_blank">${bio?.name || ""}</a>` : bio?.name || ""}
                        </p>
                    ` : ""}

                    ${profileRatingBlock}

                    ${show_reviews_count == 1 ? `
                        <div class="sk-profile__stats">
                            <p class="sk-profile__likes">${formatNumberDecimals(rcSafe)} ${reviews_text || "reviews"}</p>
                        </div>
                    ` : ""}

                    ${show_description == 1 && bio?.description ? `<p class="sk-profile__desc">${bio.description}</p>` : ""}
                </div>
            </div>

            ${show_view_on_tripadvisor_button == 1 && bio?.link ? `
                <button type="button" class="sk-profile__button" onclick="window.open('${bio.link}', '_blank')">
                    <span class="sk-profile__btn-icon">
                        ${getBrandIcon('', 'width: 18px; height: 18px;')}
                    </span>
                    ${viewTripadvisorLabel}
                </button>
            ` : ""}
        </div>
    `;
}

