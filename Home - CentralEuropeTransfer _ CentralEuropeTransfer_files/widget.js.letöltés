        show_description: 1,
        show_view_on_tripadvisor_button: 1,
        show_rating_with_text_only: 0,
        show_5_star_rating: 1,
        show_4_star_rating: 1,
        show_3_star_rating: 1,
        show_2_star_rating: 1,
        show_1_star_rating: 1,
        show_load_more_button: 1,
        excluded_posts: "",
        details_bg_color: "#ffffff",
        details_font_color: "#222222",
        item_bg_color: "#ffffff",
        item_font_color: "#222222",
        details_link_color: "#1a73e8",
        details_link_hover_color: "#1558b0",
        bold_font_color: "#222222",
        arrow_color: "#222222",
        arrow_background_color: "#ffffff",
        pop_up_bg_color: "#ffffff",
        pop_up_font_color: "#12141d",
        pop_up_link_color: "#374151",
        image_background: "#f5f5f5",
        button_bg_color: "#025DFB",
        button_text_color: "#ffffff",
        button_hover_bg_color: "#0147c7",
        button_hover_text_color: "#ffffff",
        load_more_posts_text: "Load more",
        reviews_text: "reviews",
        custom_css: ""
    };

    var settings = {};
    Object.keys(defaults).forEach(function (k) {
        settings[k] =
            settingsIn.hasOwnProperty(k) && settingsIn[k] !== undefined
                ? settingsIn[k]
                : defaults[k];
    });

    settings.layout = String(settings.layout);
    settings.post_height = Number(settings.post_height) || 350;
    settings.carousel_post_height = Number(
        pick(settings.carousel_post_height, settings.post_height, 350)
    );
    settings.column_count = Number(settings.column_count) || 3;
    settings.post_count = Number(settings.post_count) || 6;
    settings.item_content_padding = Number(settings.item_content_padding);
    if (isNaN(settings.item_content_padding)) settings.item_content_padding = 20;
    settings.item_border_radius = Number(settings.item_border_radius);
    if (isNaN(settings.item_border_radius)) settings.item_border_radius = 8;
    settings.delay = Number(settings.delay) || 8;
    settings.autoplay = Number(settings.autoplay) || 0;

    var overallNum = parseFloat(pick(bioIn.overall_rating, bioIn.average_rating, 0));
    if (isNaN(overallNum)) overallNum = 0;
    var rcRaw = pick(bioIn.review_count, bioIn.rating_count, 0);
    var reviewCountNum = parseInt(String(rcRaw).replace(/,/g, ""), 10);
    if (isNaN(reviewCountNum)) reviewCountNum = 0;

    var normalizedBio = {
        id: bioIn.place_id || bioIn.id || embedId,
        name: bioIn.name || "",
        link: toAbsoluteTripadvisorUrl(bioIn.link || ""),
        image: bioIn.image || "",
        description: bioIn.description || "",
        location: bioIn.location || "",
        phone_number: bioIn.phone_number || "",
        overall_rating: overallNum,
        average_rating: overallNum,
        review_count: reviewCountNum,
        rating_count: reviewCountNum
    };

    var normalizedReviews = reviews.map(function (review, index) {
        var reviewUrl = toAbsoluteTripadvisorUrl(review.review_link || review.link || "");
        var title = review.review_title || "";
        var rawText = review.review_text || "";
        var combinedHtml = (title ? "<strong>" + title + "</strong><br>" : "") + rawText;
        var rid = String(
            pick(review.review_id, review.id, "tripadvisor-review-" + embedId + "-" + index)
        );
        var stars = pick(review.review_stars, review.rating, 0);
        return Object.assign({}, review, {
            id: rid,
            review_id: rid,
            reviewer_name: review.reviewer_name || "Anonymous",
            reviewer_link: review.reviewer_link || reviewUrl || normalizedBio.link || "#",
            reviewer_profile: review.reviewer_profile || "",
            review_title: title,
            review_link: reviewUrl || normalizedBio.link || "#",
            review_text: combinedHtml,
            review_text_raw: rawText,
            review_date: review.review_date || "",
            post_date_time: review.review_date || "",
            rating: String(stars),
            review_stars: String(stars)
        });
    });

    return Object.assign({}, widgetData, {
        settings: settings,
        bio: normalizedBio,
        reviews: normalizedReviews,
        posts: normalizedReviews
    });
}
