function formatNumberComma(number) {
    if (isNaN(number) || number === null || number === undefined) {
        return "0";
    }
    return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
}

function formatNumberDecimals(num) {
  if (num >= 1_000_000_000) return (num / 1_000_000_000).toFixed(1).replace(/\.0$/, "") + "B";
  if (num >= 1_000_000)     return (num / 1_000_000).toFixed(1).replace(/\.0$/, "") + "M";
  if (num >= 1_000)         return (num / 1_000).toFixed(1).replace(/\.0$/, "") + "k";
  return num.toString();
}

function toAbsoluteTripadvisorUrl(url) {
    if (!url) return "";
    if (String(url).indexOf("http://") === 0 || String(url).indexOf("https://") === 0) {
        return url;
    }
    return "https://www.tripadvisor.com" + url;
}

function normalizeTripadvisorWidgetData(widgetData, embedId) {
    widgetData = widgetData || {};
    var settingsIn = widgetData.settings || {};
    var bioIn = widgetData.bio || {};
    var reviews = Array.isArray(widgetData.reviews) ? widgetData.reviews : [];

    function pick() {
        for (var i = 0; i < arguments.length; i++) {
            var v = arguments[i];
            if (v !== undefined && v !== null && v !== "") {
                return v;
            }
        }
        return undefined;
    }

    var defaults = {
        font_family: "Arial",
        layout: "1",
        post_height: 350,
        carousel_post_height: 350,
        column_count: 3,
        post_count: 6,
        item_content_padding: 20,
