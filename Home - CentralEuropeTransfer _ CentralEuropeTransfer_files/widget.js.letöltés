function renderMasonryHTML(widget, widgetState, reviews) {
    let wrapper = widget.querySelector(".js-masonry");

    const {
        settings
    } = widgetState.widget_data;

    if (!wrapper) {
        wrapper = document.createElement("div");
        wrapper.className = "sk-wrapper masonry js-masonry";
        const postsContainer = widget.querySelector(".js-posts-container");
        postsContainer.querySelectorAll(".js-grid, .js-list, .sk-carousel").forEach(function (el) { el.remove(); });
        postsContainer.prepend(wrapper);
    }

    let reviewBadge = widget.querySelector('.sk-badge');
    let postsHTML;

    const showRating = settings.show_overall_rate == 1; 

    postsHTML = reviews.map((review) => generateHTMLPost(review, widgetState));

    if (showRating && !reviewBadge && reviews.length > 0) {
        postsHTML = [generateHTMLBadge(widgetState), ...postsHTML];
    }

    postsHTML.forEach((item) => {
        const masonryItem = document.createElement("div");
        masonryItem.className = "sk-masonry-item js-masonry-item";
        masonryItem.innerHTML = item;
        wrapper.appendChild(masonryItem);
    });
}

function masonry(widget, widgetState) {
    const {
        widget_data
    } = widgetState;
    const {
        settings
    } = widget_data;
    const masonry = widget.querySelector(".js-masonry");
    const items = masonry.querySelectorAll(".js-masonry-item");

    // media column in utils.php
    let columns = getMediaColumn(widget,widgetState,settings);
    setTimeout(function(){
        widget.style.setProperty("--column-count", columns);
    },100);

    const columnHeights = Array(columns).fill(0); // Initialize column heights

    // Step 1: Temporarily position items in the center
    items.forEach((item) => {
        item.style.position = "absolute";
        item.style.top = "50%";
        item.style.left = "50%";
        item.style.transform = "translate(-50%, -50%) scale(0.1)";
        item.style.opacity = "0.3";
    });

    // Step 2: Calculate final positions and animate
    setTimeout(() => {
        items.forEach((item) => {
            const minColumnHeight = Math.min(...columnHeights);
            const columnIndex = columnHeights.indexOf(minColumnHeight);

            item.style.top = `${minColumnHeight}px`;
            item.style.left = `${(100 / columns) * columnIndex}%`;
            item.style.transform = ""; // Remove transformation to move to final position
            item.style.opacity = "1";

            columnHeights[columnIndex] += item.offsetHeight + 16; // Update column height
        });

        // Set the height of the masonry container
        masonry.style.height = `${Math.max(...columnHeights)}px`;
    }, 0); // Small delay to allow initial positioning to take effect

    if (widgetState.realignmentTimeoutId) {
        clearTimeout(widgetState.realignmentTimeoutId);
    }

    widgetState.realignmentTimeoutId = setTimeout(() => {
        realignMasonry(widget, widgetState);
    }, 2000);

    setTimeout(() => {
        widget.querySelector('.sk-posts-container').style.visibility = "visible";
        widget.querySelector('.sk-profile').style.visibility = "visible";
        widget.querySelector('.sk-posts-container__loader').style.display = "none";
    }, 50);
}

function observeMasonryItems(widget, widgetState) {
    const wrapper = widget.querySelector('.js-masonry');
    if (!wrapper) return;
  
    let resizeTimeout;
    const debounceRealign = () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => realignMasonry(widget, widgetState), 100);
    };
  
    const observer = new ResizeObserver(() => debounceRealign());
    const mutationObserver = new MutationObserver(() => observeItems());
  
    const observeItems = () => {
      wrapper.querySelectorAll('.js-masonry-item').forEach(item => observer.observe(item));
    };
  
    observeItems();
    mutationObserver.observe(wrapper, { childList: true, subtree: true });
}

function realignMasonry(widget, widgetState) {
    const {
        widget_data
    } = widgetState;
    const {
        settings
    } = widget_data;
    const masonry = widget.querySelector(".js-masonry");
    const items = Array.from(masonry.querySelectorAll(".js-masonry-item"));

    // media column in utils.php
    let columns = getMediaColumn(widget,widgetState,settings);
    setTimeout(function(){
        widget.style.setProperty("--column-count", columns);
    },100);
    
    const columnHeights = Array(columns).fill(0); // Initialize column heights

    // Step 1: Reset item positions
    items.forEach((item) => {
        item.style.position = "absolute"; // Ensure items are positioned absolutely
        item.style.top = "1px";
        item.style.left = "1px";
        item.style.transform = "";
    });

    // Step 2: Recalculate column heights and position items
    items.forEach((item) => {
        const minColumnHeight = Math.min(...columnHeights);
        const columnIndex = columnHeights.indexOf(minColumnHeight);

        // Position item
        item.style.top = `${minColumnHeight}px`;
        item.style.left = `${(100 / columns) * columnIndex}%`;
        item.style.transform = "";

        // Update column height
        columnHeights[columnIndex] += item.offsetHeight + 16; // Account for gap between items
    });

    // Step 3: Set the height of the masonry container
    masonry.style.height = `${Math.max(...columnHeights)}px`;
