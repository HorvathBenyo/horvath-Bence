/**
    * Sorts the list of review objects in such a way that 
    * no consecutive reviews are from the same source.
    * Uses a greedy algorithm.
    */
function sortNoConsecutive(reviews) {
    // Group reviews by their source
    const grouped = reviews.reduce((acc, review) => {
        acc[review.solution_category_name] = acc[review.solution_category_name] || [];
        acc[review.solution_category_name].push(review);
        return acc;
    }, {});

    // Convert grouped reviews to an array of sources
    const sources = Object.keys(grouped);
    const sortedReviews = [];

    // Sort reviews in a round-robin fashion
    while (sortedReviews.length < reviews.length) {
        for (let i = 0; i < sources.length; i++) {
            const source = sources[i];
            if (grouped[source].length > 0) {
                // Check if the previous review is from the same source
                if (sortedReviews.length === 0 || sortedReviews[sortedReviews.length - 1].source !== source) {
                    sortedReviews.push(grouped[source].shift());
                }
            }
        }
    }

    return sortedReviews;
}

function setupTooltip(widget) {
  const tooltip = document.createElement("div");
  tooltip.id = "sk-tooltip";
  tooltip.className = "sk-tooltip";
  tooltip.innerHTML = '<div class="sk-tooltip-content"></div>';
  const skContentAggregator = widget.querySelector(".js-sk-page-reviews");
  skContentAggregator.prepend(tooltip);

  function showTooltip(event) {
    const target = event.target.closest("[data-tooltip]");

    // Hide tooltip when share popup is active
    if (widget.querySelector('.sk-share-popup--active')) {
        return;
    }

    if (target) {
      const tooltip = document.getElementById("sk-tooltip");
      const tooltipContent = tooltip.querySelector(".sk-tooltip-content");

      const position = target.getAttribute("data-position") || "top";

      tooltipContent.textContent = target.getAttribute("data-tooltip");

      // Ensure tooltip is visible to measure its dimensions
      tooltip.style.visibility = "hidden";
      tooltip.style.display = "block";

      const tooltipRect = tooltip.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();

      let left, top;

      const margin = 10;

      switch (position) {
        case "top":
          left = targetRect.left + targetRect.width / 2 - tooltipRect.width / 2;
          top = targetRect.top - tooltipRect.height - margin;
          break;
        case "bottom":
          left = targetRect.left + targetRect.width / 2 - tooltipRect.width / 2;
          top = targetRect.bottom + margin;
          break;
        case "left":
          left = targetRect.left - tooltipRect.width - margin;
          top = targetRect.top + targetRect.height / 2 - tooltipRect.height / 2;
          break;
        case "right":
          left = targetRect.right + margin;
          top = targetRect.top + targetRect.height / 2 - tooltipRect.height / 2;
          break;
        default:
          left = targetRect.left + targetRect.width / 2 - tooltipRect.width / 2;
          top = targetRect.top - tooltipRect.height - margin;
          break;
      }

      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${top}px`;

      tooltip.style.visibility = "visible";
      tooltip.classList.add("sk-tooltip--active");
    }
  }

  function hideTooltip() {
    tooltip.classList.remove("sk-tooltip--active");
    tooltip.style.position = "";
    tooltip.style.top = "-100%"; // TODO: Quick fix
    tooltip.style.left = "";
    tooltip.style.transform = "";
  }

  widget.addEventListener("mouseover", showTooltip);
  widget.addEventListener("mousemove", showTooltip);
  widget.addEventListener("mouseout", hideTooltip);
}

function forceHideTooltips(widget) {
    const activeTooltips = widget.querySelectorAll('.sk-tooltip--active');

