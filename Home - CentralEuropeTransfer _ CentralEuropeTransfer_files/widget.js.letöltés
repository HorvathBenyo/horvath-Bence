function filterTripadvisorExcludedPosts(posts, settings) {
    if (!posts || !posts.length) return posts || [];
    var excluded = settings.excluded_posts;
    if (!excluded || String(excluded).trim() === "") return posts;
    var excludeSet = {};
    String(excluded).split(",").forEach(function (s) {
        var t = s.trim();
        if (t) excludeSet[t] = true;
    });
    return posts.filter(function (item) {
        var id = String(item.review_id != null ? item.review_id : item.id || "");
        return !excludeSet[id];
    });
}

