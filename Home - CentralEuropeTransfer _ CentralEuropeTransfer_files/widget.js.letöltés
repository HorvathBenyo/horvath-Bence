function renderPosts(widget, widgetState) {
    const {
        widget_data,
        currentPage,
        itemsPerPage,
        currentTab,
        searchTerm
    } =
    widgetState;
    const {
        reviews,
        settings,
        bio
    } = widget_data;

    
    let filteredPosts = reviews;
    if (currentTab && currentTab !== "All") {
        filteredPosts = reviews.filter(
            (post) =>
            post.widget_name === currentTab ||
            post.solution_category_name === currentTab ||
            (currentTab == widgetState.widget_data.settings.submitted_tab_text &&
                post.solution_category_name == "Submitted"
            )
        );
    }

    let searchedPosts = filteredPosts;
    if (searchTerm && searchTerm !== "") {
        searchedPosts = filteredPosts.filter((post) => {
            const lowerCaseSearchTerm = searchTerm.toLowerCase();
            return (
                (post.reviewer_name &&
                    post.reviewer_name.toLowerCase().includes(lowerCaseSearchTerm)) ||
                (post.review_text &&
                    post.review_text.toLowerCase().includes(lowerCaseSearchTerm)) ||
                (post.review_title &&
                    post.review_title.toLowerCase().includes(lowerCaseSearchTerm)) ||
                (post.widget_name &&
                    post.widget_name.toLowerCase().includes(lowerCaseSearchTerm)) ||
                (post.solution_category_name &&
                    post.solution_category_name
                    .toLowerCase()
                    .includes(lowerCaseSearchTerm))
            );
        });
    }

    let sortedPosts = filterTripadvisorExcludedPosts(searchedPosts, settings);
    sortedPosts = showByRating(sortedPosts, settings);
    sortedPosts = showWithTextOnly(sortedPosts, widget_data.settings, widget_data.bio);
    sortedPosts = sortPosts(sortedPosts, String(settings.order_by != null ? settings.order_by : "0"));

    const start = (currentPage - 1) * Number(itemsPerPage);
    const end = start + Number(itemsPerPage);
    const displayPosts = sortedPosts.slice(start, end);
    const totalPages = Math.ceil(sortedPosts.length / itemsPerPage);
    const isLastPage = currentPage >= totalPages;
    const isCarousel = settings.layout == "3";

    if (settings.layout == "1") {
        renderGrid(widget, widgetState, displayPosts);
    } else if (settings.layout == "2") {
        renderMasonry(widget, widgetState, displayPosts);
    } else if (settings.layout == "3") {
        renderCarousel(widget, widgetState, sortedPosts);
    } else if (settings.layout == "4") {
        renderList(widget, widgetState, displayPosts);
    } else {
        renderMasonry(widget, widgetState, displayPosts);
    }

    const loadMoreBtnContainer = widget.querySelector(
        ".js-load-more-btn-container"
    );
    const loadMoreBtn = widget.querySelector(".js-load-more-btn");

    if (!loadMoreBtn && !isCarousel && settings.show_load_more_button == 1 && displayPosts.length > 0 && displayPosts.length < sortedPosts.length) {
        loadMoreBtnContainer.insertAdjacentHTML(
            "beforeend",
            `<button class="sk-button sk-load-more-btn js-load-more-btn">${settings.load_more_posts_text}</button>`
        );
    }

    if (loadMoreBtn) {
        if (isLastPage || isCarousel) {
            loadMoreBtn.style.display = "none";
        } else {
            loadMoreBtn.style.display = "inline-block";
        }
    }
}

