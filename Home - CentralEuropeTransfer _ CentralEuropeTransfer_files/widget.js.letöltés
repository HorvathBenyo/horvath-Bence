function modalReviewMatchesPostId(review, postId) {
    if (postId == null || postId === "") return false;
    const needle = String(postId);
    const candidates = [
        review.review_id,
        review.id,
        review.reviewer_id,
        review.review_link,
        review.link
    ].filter((v) => v !== undefined && v !== null && v !== "");
    return candidates.some((c) => String(c) === needle);
}

// The popup browses the list the visitor actually sees, not the raw feed.
function skTripadvisorModalPosts(widgetState) {
    const sorted = widgetState.sortedPosts;
    if (Array.isArray(sorted) && sorted.length > 0) return sorted;
    const reviews = widgetState.widget_data && widgetState.widget_data.reviews;
    return Array.isArray(reviews) ? reviews : [];
}

// Review text arrives as raw HTML, so its anchors need the target added here.
function skTripadvisorLinksOpenInNewTab(container) {
    if (!container) return;

    container.querySelectorAll("a[href]").forEach(function (link) {
        link.setAttribute("target", "_blank");
        link.setAttribute("rel", "noopener noreferrer");
    });
}

// Reviews at the edges of the list keep their button on screen, just inert.
function skTripadvisorUpdateModalNav(widget, widgetState) {
    const modal = widget.querySelector(".js-post-modal");
    if (!modal) return;

    const total = skTripadvisorModalPosts(widgetState).length;
    const index = Number(widgetState.currentIndex) || 0;
    const elBtnPrev = modal.querySelector(".js-post-modal-btn-left");
    const elBtnNext = modal.querySelector(".js-post-modal-btn-right");
    const elKbdBrowse = modal.querySelector(".js-post-modal-kbd-browse");

    if (elBtnPrev) elBtnPrev.disabled = index <= 0;
    if (elBtnNext) elBtnNext.disabled = index >= total - 1;
    if (elKbdBrowse) elKbdBrowse.style.display = total > 1 ? "" : "none";
}

function skTripadvisorFlashModalChromeButton(button) {
    if (!button || button.disabled) return;

    button.classList.remove("sk-post-modal__btn--keypress");
    void button.offsetWidth;
    button.classList.add("sk-post-modal__btn--keypress");
    window.setTimeout(function () {
        button.classList.remove("sk-post-modal__btn--keypress");
    }, 220);
}

const SK_TRIPADVISOR_MODAL_FOCUSABLE =
    'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])';

// Escape closes, arrows move between reviews, Tab stays inside the dialog.
function skTripadvisorHandleModalKeydown(event) {
    const state = window.skTripadvisorActiveModal;
    if (!state) return;

    const { modal, widget, widgetState } = state;

    if (event.key === "Escape") {
        event.preventDefault();
        event.stopPropagation();
        skTripadvisorFlashModalChromeButton(modal.querySelector(".js-post-modal-btn-close"));
        closeModal(widget);
        return;
    }

    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.preventDefault();
        event.stopPropagation();

        const isNext = event.key === "ArrowRight";
        const button = modal.querySelector(
            isNext ? ".js-post-modal-btn-right" : ".js-post-modal-btn-left"
        );

        if (button && button.disabled) return;

        skTripadvisorFlashModalChromeButton(button);

        if (isNext) {
            showNextPost(widget, widgetState);
        } else {
            showPreviousPost(widget, widgetState);
        }
        return;
    }

    if (event.key !== "Tab") return;

    const focusable = Array.from(modal.querySelectorAll(SK_TRIPADVISOR_MODAL_FOCUSABLE)).filter(
        (el) => el.offsetParent !== null || el === document.activeElement
    );

    if (focusable.length === 0) {
        event.preventDefault();
        modal.focus({ preventScroll: true });
        return;
    }

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
    }
}

function openModal(widget, widgetState, reviewId) {
    const {
        widget_data
    } = widgetState;
    const {
        settings
    } = widget_data;
    const reviews = skTripadvisorModalPosts(widgetState);

    if (settings.disable_popup && settings.disable_popup == 1) {
        return;
    } 

    const reviewsData = reviews.find((review) =>
        modalReviewMatchesPostId(review, reviewId)
    );

    if (!reviewsData) {
        console.error("Post ID was not found");
        return;
    }

    widgetState.currentIndex = reviews.indexOf(reviewsData);

    updateModalContent(widget, widgetState, reviewsData);

    const elModalOverlay = widget.querySelector(".js-post-modal-overlay");
    const elModal = widget.querySelector(".js-post-modal");
    const elModalBtnClose = widget.querySelector(".js-post-modal-btn-close");

    if (elModalOverlay)
        elModalOverlay.classList.add("sk-post-modal-overlay--active");
    if (elModal) elModal.classList.add("sk-post-modal--active");
    if (elModalBtnClose)
        elModalBtnClose.classList.add("sk-post-modal__btn-close--active");
    document.body.style.overflow = "hidden";

    if (!elModal) return;

    window.skTripadvisorActiveModal = {
        modal: elModal,
        widget,
        widgetState,
        lastFocused: document.activeElement
    };

    document.addEventListener("keydown", skTripadvisorHandleModalKeydown, true);

    // Focus the dialog itself so no button or link starts out highlighted.
    elModal.focus({ preventScroll: true });
}

function closeModal(widget) {
    const elModalOverlay = widget.querySelector(".js-post-modal-overlay");
    const elModal = widget.querySelector(".js-post-modal");
    const elModalBtnClose = widget.querySelector(".js-post-modal-btn-close");
    const elModalMedia = widget.querySelector(".js-post-modal-iframe-container");
    const elModalIframeContainer = widget.querySelector(".js-post-modal-media");

    if (elModalOverlay)
        elModalOverlay.classList.remove("sk-post-modal-overlay--active");
    if (elModal) elModal.classList.remove("sk-post-modal--active");
    if (elModalBtnClose)
        elModalBtnClose.classList.remove("sk-post-modal__btn-close--active");
    document.body.style.overflow = "";
    if (elModalIframeContainer) elModalIframeContainer.remove();
    if (elModalMedia) elModalMedia.remove();

    document.removeEventListener("keydown", skTripadvisorHandleModalKeydown, true);

    const state = window.skTripadvisorActiveModal;
    if (state && state.lastFocused && typeof state.lastFocused.focus === "function") {
        state.lastFocused.focus({ preventScroll: true });
    }
    window.skTripadvisorActiveModal = null;
}

function showPreviousPost(widget, widgetState) {
    const reviews = skTripadvisorModalPosts(widgetState);

    if (widgetState.currentIndex > 0) {
        widgetState.currentIndex--;
        updateModalContent(widget, widgetState, reviews[widgetState.currentIndex]);
    }
}

function showNextPost(widget, widgetState) {
    const reviews = skTripadvisorModalPosts(widgetState);

    if (widgetState.currentIndex < reviews.length - 1) {
        widgetState.currentIndex++;
        updateModalContent(widget, widgetState, reviews[widgetState.currentIndex]);
    }
}

