function applyImageFallback(img, sources) {
    const validSources = sources.filter(Boolean);
    if (!img || validSources.length === 0) return;

    let index = 0;

    img.src = validSources[index];

    img.onerror = () => {
        index++;

        if (index < validSources.length) {
            img.src = validSources[index];
        } else {
            img.onerror = null;
        }
    };
}

